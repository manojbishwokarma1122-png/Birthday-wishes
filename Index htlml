
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luxury Birthday Surprise</title>

<style>
*{margin:0;padding:0;box-sizing:border-box}

body{
 background:radial-gradient(circle at center,#35132e,#090512 75%);
 color:white;
 font-family:Georgia,serif;
 min-height:100vh;
 overflow:hidden;
 text-align:center;
}

.container{
 min-height:100vh;
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 padding:20px;
 position:relative;
}

.glow{
 position:absolute;
 width:280px;height:280px;
 background:#ff4c9a;
 filter:blur(120px);
 opacity:.3;
}

h1{
 color:#ffd98a;
 font-size:clamp(30px,8vw,48px);
 text-shadow:0 0 25px #ffb347;
 animation:fade 2s;
}

.subtitle{
 color:#f7c6df;
 margin:12px 0 55px;
 letter-spacing:3px;
 font-size:12px;
}

.cake{
 position:relative;
 width:230px;
 height:180px;
 margin-bottom:35px;
 filter:drop-shadow(0 0 25px #ff65ad);
 animation:float 3s ease-in-out infinite;
}

.layer{
 position:absolute;
 width:100%;
 height:75px;
 border-radius:15px 15px 22px 22px;
 background:linear-gradient(135deg,#ffb6d6,#e83c8b,#9d165c);
 border-bottom:8px solid #9d174f;
 box-shadow:inset 0 8px 15px #fff8;
}

.layer.top{
 top:40px;
 width:75%;
 left:12.5%;
 height:65px;
 background:linear-gradient(135deg,#ffe3f0,#ff80b7,#d92b78);
 z-index:2;
}

.layer.bottom{
 bottom:0;
}

.cream{
 position:absolute;
 top:92px;
 width:100%;
 height:24px;
 border-radius:50%;
 background:#fff0f6;
 z-index:3;
}

.candle{
 position:absolute;
 top:0;
 left:50%;
 transform:translateX(-50%);
 width:12px;
 height:52px;
 background:repeating-linear-gradient(
 45deg,#fff,#fff 5px,#ff70a8 5px,#ff70a8 10px);
 border-radius:4px;
 z-index:5;
}

.flame{
 position:absolute;
 top:-22px;
 left:50%;
 transform:translateX(-50%);
 width:15px;
 height:23px;
 background:linear-gradient(#fff7a1,#ff8b00,#ff3b00);
 border-radius:50% 50% 45% 45%;
 box-shadow:0 0 20px #ffb52e;
 animation:flicker .5s infinite alternate;
}

.candle.off .flame{display:none}

button{
 padding:15px 30px;
 border:1px solid #ffd98a;
 border-radius:40px;
 background:linear-gradient(120deg,#ffd98a,#bd7728);
 color:#32101f;
 font-size:15px;
 font-weight:bold;
 cursor:pointer;
 box-shadow:0 0 25px #ffb34766;
}

button:active{transform:scale(.95)}

.message{
 opacity:0;
 transform:translateY(25px);
 transition:1.5s;
 margin-top:30px;
}

.message.show{
 opacity:1;
 transform:translateY(0);
}

.message h2{
 color:#ffd98a;
 font-size:30px;
 margin-bottom:12px;
}

.message p{
 color:#ffe1f0;
 line-height:1.8;
}

#particles{
 position:fixed;
 inset:0;
 pointer-events:none;
}

.confetti{
 position:absolute;
 top:-15px;
 width:9px;
 height:14px;
 animation:fall linear forwards;
}

@keyframes float{
 50%{transform:translateY(-12px)}
}

@keyframes flicker{
 to{transform:translateX(-50%) scale(.8,1.2)}
}

@keyframes fade{
 from{opacity:0;transform:translateY(-20px)}
 to{opacity:1;transform:translateY(0)}
}

@keyframes fall{
 to{transform:translateY(110vh) rotate(900deg);opacity:0}
}
</style>
</head>

<body>
<div id="particles"></div>

<div class="container">
<div class="glow"></div>

<h1>Make A Wish ✨</h1>
<div class="subtitle">A MAGICAL BIRTHDAY EXPERIENCE</div>

<div class="cake">
 <div class="candle" id="candle">
  <div class="flame"></div>
 </div>
 <div class="layer top"></div>
 <div class="cream"></div>
 <div class="layer bottom"></div>
</div>

<button id="wishButton" onclick="celebrate()">
 ✨ BLOW THE CANDLES ✨
</button>

<div class="message" id="message">
 <h2>Happy Birthday ❤️</h2>
 <p>
 You are someone's most beautiful reason to smile.<br>
 May your life shine brighter than a thousand stars.
 </p>
 <h2 style="margin-top:18px">Forever Special 💖</h2>
</div>

</div>

<script>
function celebrate(){
 const candle=document.getElementById("candle");
 const message=document.getElementById("message");
 const button=document.getElementById("wishButton");

 candle.classList.add("off");
 message.classList.add("show");
 button.innerText="🎉 YOUR WISH IS BLOWN!";

 for(let i=0;i<180;i++){
  const piece=document.createElement("div");
  piece.className="confetti";
  piece.style.left=Math.random()*100+"%";
  piece.style.background=
  ["#ffd700","#ff69b4","#ffffff","#ff4081"][Math.floor(Math.random()*4)];
  piece.style.animationDuration=(2+Math.random()*4)+"s";
  document.getElementById("particles").appendChild(piece);

  setTimeout(()=>piece.remove(),6500);
 }
}
</script>
</body>
</html>
